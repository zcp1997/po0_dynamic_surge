#!name=PO0 Dynamic Whitelist
#!desc=IPv4 dynamic FIFO whitelist | Configure API_HOST, TOKEN and SCRIPT_URL in module parameters
#!arguments=API_HOST=fw.example.com&TOKEN=CHANGE_ME&SCRIPT_URL=https://fw.example.com/static/whitelist.js

[Rule]
DOMAIN,%API_HOST%,DIRECT

[Script]
po0-dynamic-cron = type=cron,cronexp="*/10 * * * *",script-path=%SCRIPT_URL%,argument="token=%TOKEN%&url=https%3A%2F%2F%API_HOST%",timeout=30
po0-dynamic-change = type=event,event-name=network-changed,script-path=%SCRIPT_URL%,argument="token=%TOKEN%&url=https%3A%2F%2F%API_HOST%",timeout=30
po0-dynamic-panel = type=generic,script-path=%SCRIPT_URL%,argument="token=%TOKEN%&url=https%3A%2F%2F%API_HOST%",timeout=30

[Panel]
po0-dynamic = script-name=po0-dynamic-panel,title=PO0 动态加白,content=点击更新,update-interval=300
